{
    "name": "pik/npd-project-control",
    "description": "NPD Project Control v3.0 — PT. Permata Indo Kemas (PHP native + MySQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "ext-sodium": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build-seed": "php bin/build-seed.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
