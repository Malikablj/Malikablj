# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# API server
PORT=4000

# PostgreSQL connection for the application.
DATABASE_URL=postgres://pik:change_me@localhost:5432/pik_marketing

# Separate database used by `npm test`. Its name MUST end with "_test": the test setup
# recreates its schema on every run.
DATABASE_URL_TEST=postgres://pik:change_me@localhost:5432/pik_marketing_test

# Optional: database for `npm run test:e2e` (name must end with "_e2e"; recreated on every run).
# Defaults to DATABASE_URL_TEST with "_test" replaced by "_e2e".
DATABASE_URL_E2E=

# Used to sign session tokens. Production requires at least 32 random characters,
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# How long a login session stays valid, in hours.
SESSION_TTL_HOURS=168

# Browser origin allowed to call the API (the Vite dev server in development).
CORS_ORIGIN=http://localhost:5173

# Business timezone. "Today" for follow-ups and dashboards is computed here.
APP_TIMEZONE=Asia/Jakarta

# Set to 1 when running behind a reverse proxy / load balancer (secure cookies, client IPs).
TRUST_PROXY=0

# The app is served over HTTPS: Secure session cookie, HSTS and upgrade-insecure-requests.
# Defaults to 1 when NODE_ENV=production. Set 0 only for a trusted intranet served over plain HTTP.
COOKIE_SECURE=

# First administrator account, used once by `npm run db:seed`.
# If ADMIN_PASSWORD is empty a random password is generated and printed once.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only used by docker-compose.yml for the local PostgreSQL container.
POSTGRES_PASSWORD=change_me
