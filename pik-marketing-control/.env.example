# =============================================================================
# PIK Marketing Control — contoh konfigurasi
# Salin menjadi .env lalu isi sesuai server Anda:  cp .env.example .env
# File .env berisi kredensial: JANGAN di-commit ke git / jangan dibagikan.
# =============================================================================

# production | development
APP_ENV=production
# true hanya saat development (menampilkan detail error)
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Alamat situs TANPA subfolder (dipakai untuk link di email QC)
APP_URL=https://marketing.permataindokemas.com
# Kosongkan untuk deteksi otomatis. Contoh subfolder: /pik
APP_BASE_PATH=
# Set false bila server tidak mendukung mod_rewrite (URL menjadi /index.php/...)
APP_PRETTY_URLS=true
# true bila situs memakai HTTPS (redirect otomatis http -> https)
FORCE_HTTPS=false

# Database MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pik_marketing
DB_USERNAME=pik_app
DB_PASSWORD=ganti_dengan_password_database
# Opsional: path unix socket (kosongkan bila memakai host/port)
DB_SOCKET=
# Zona waktu sesi database, samakan dengan APP_TIMEZONE (Asia/Jakarta = +07:00)
DB_TIMEZONE=+07:00

# Session (menit tidak aktif sebelum logout otomatis)
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Email (hasil komplain dikirim ke email QC)
# log  = email TIDAK dikirim, hanya dicatat di storage/logs/mail-*.log (untuk uji coba)
# smtp = kirim lewat server SMTP email perusahaan (isi MAIL_HOST dst.)
# mail = kirim lewat fungsi mail() bawaan hosting
MAIL_DRIVER=log
MAIL_HOST=mail.permataindokemas.com
MAIL_PORT=587
# tls (port 587) | ssl (port 465) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@permataindokemas.com
MAIL_FROM_NAME="PIK Marketing Control"
MAIL_TIMEOUT=15
