# =====================================================================
# NPD Project Control v3.0 — konfigurasi lingkungan
# Salin menjadi .env lalu sesuaikan. File .env TIDAK boleh berada di webroot
# dan tidak di-commit ke git.
# =====================================================================

# development | uat | production   (detail error hanya tampil di development)
APP_ENV=production
APP_DEBUG=0
# URL absolut aplikasi (dipakai di tautan email), tanpa garis miring di akhir
APP_URL=https://npd.example.co.id
# Kunci enkripsi 32 byte (base64). Buat dengan: php bin/generate-key.php
APP_KEY=
APP_TIMEZONE=Asia/Jakarta

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=npd_project_control
DB_USER=npd_app
DB_PASS=
# Opsional: socket unix (kosongkan bila memakai host/port)
DB_SOCKET=

# Cookie sesi: auto (Secure bila HTTPS) | 1 (selalu Secure) | 0
SESSION_SECURE=auto
SESSION_NAME=NPDSESSID
# Lokasi file sesi (kosong = bawaan PHP). Disarankan: storage/sessions
SESSION_SAVE_PATH=

# Proxy tepercaya (reverse proxy/load balancer), pisahkan koma. Kosong = tidak ada.
# Bila diisi, IP klien dibaca dari X-Forwarded-For dan HTTPS dari X-Forwarded-Proto.
TRUSTED_PROXIES=

# Lokasi storage di luar webroot (kosong = ./storage)
STORAGE_PATH=

# SMTP bawaan (dapat ditimpa Admin di Pengaturan > Notifikasi)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NPD Project Control"

# Backup harian (php bin/backup.php) — sebaiknya disk lain, di luar webroot
BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
# User MySQL khusus backup: GRANT SELECT, SHOW VIEW, TRIGGER (lihat php bin/db-grants.php --role=backup).
# Kosong = memakai DB_USER; tanpa hak TRIGGER, trigger append-only audit_logs TIDAK ikut ter-backup.
BACKUP_DB_USER=
BACKUP_DB_PASS=
# Lokasi program bila tidak ada di PATH (mis. Windows: C:\xampp\mysql\bin\mysqldump.exe)
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
TAR_BIN=tar
