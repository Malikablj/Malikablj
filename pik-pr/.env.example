# ------------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------------
APP_NAME="PR PIK"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------
# Database - hanya MySQL 8.0+ (driver PDO: pdo_mysql)
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pik_pr
DB_USERNAME=root
DB_PASSWORD=

# Database terpisah untuk automated test (akan dikosongkan setiap test dijalankan)
DB_TEST_DATABASE=pik_pr_test

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_NAME=pik_pr_session
# Menit tanpa aktivitas sebelum user otomatis logout
SESSION_LIFETIME=120
# Set true bila aplikasi diakses lewat HTTPS
SESSION_SECURE_COOKIE=false

# ------------------------------------------------------------------
# Upload attachment (disimpan di luar folder public)
# ------------------------------------------------------------------
UPLOAD_PATH=storage/uploads
UPLOAD_MAX_MB=5

# ------------------------------------------------------------------
# Password akun demo yang dibuat oleh seeder (kosong = PikDemo2026!)
# ------------------------------------------------------------------
SEED_PASSWORD=
