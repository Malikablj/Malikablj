{
    "name": "pik/purchase-requisition",
    "description": "Aplikasi Purchase Requisition (PR) internal PT Permata Indo Kemas - PHP 8.2+ dan MySQL 8.0+",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "@php bin/migrate.php",
        "migrate:fresh": "@php bin/migrate.php --fresh --seed",
        "seed": "@php bin/seed.php",
        "serve": "@php -S 127.0.0.1:8000 -t public public/index.php",
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
